{
  "agent-capture": {
    "enabled": true,
    "Stop": [
      {
        "type": "command",
        "command": "python scripts/agent_capture.py",
        "timeout": 30
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "python scripts/agent_capture.py",
        "timeout": 30
      }
    ]
  }
}
